{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://anvild-nasa-space-apps-production.up.railway.app/api/$1"
    },
    {
      "source": "/(Logo.png|logo.png|logo_thumb.png)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}
